{
	"name": "@superset/device-bridge",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./renderer": {
			"types": "./src/renderer/index.ts",
			"default": "./src/renderer/index.ts"
		},
		"./preload": {
			"types": "./src/preload/index.ts",
			"default": "./src/preload/index.ts"
		}
	},
	"files": ["bin", "proto", "src"],
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false",
		"test": "bun test --pass-with-no-tests"
	},
	"dependencies": {
		"@grpc/grpc-js": "^1.14.3",
		"@grpc/proto-loader": "^0.8.0"
	},
	"devDependencies": {
		"@superset/typescript": "workspace:*",
		"@types/node": "^24.9.1",
		"bun-types": "^1.3.1",
		"typescript": "^5.9.3"
	}
}
