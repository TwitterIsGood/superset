{
	"extends": "@superset/typescript/internal-package.json",
	"compilerOptions": {
		"types": ["bun-types"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"skipLibCheck": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "src/renderer/h264-decoder.ts", "src/renderer/device-stream.ts", "src/renderer/ipc-client.ts", "src/renderer/*.test.ts", "src/android/*.test.ts", "src/ios/*.test.ts"]
}
