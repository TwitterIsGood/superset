{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://superset.sh/schemas/desktop-pack-manifest.schema.json",
	"title": "Superset Desktop Resource Pack Manifest",
	"type": "object",
	"additionalProperties": false,
	"required": ["packId", "version", "downloadUrl", "files"],
	"properties": {
		"schemaVersion": { "const": 1 },
		"packId": {
			"type": "string",
			"pattern": "^[a-z0-9][a-z0-9._-]*$"
		},
		"version": {
			"type": "string",
			"pattern": "^[0-9A-Za-z.+-]+$"
		},
		"minAppVersion": { "type": "string", "minLength": 1 },
		"appVersionRange": { "type": "string", "minLength": 1 },
		"downloadUrl": { "type": "string", "format": "uri" },
		"archive": {
			"type": "object",
			"additionalProperties": false,
			"required": ["format", "path", "size", "sha256"],
			"properties": {
				"format": { "const": "zip" },
				"path": { "$ref": "#/$defs/relativePath" },
				"size": { "type": "integer", "minimum": 1 },
				"sha256": {
					"type": "string",
					"pattern": "^[a-fA-F0-9]{64}$"
				},
				"downloadUrl": { "type": "string", "format": "uri" }
			}
		},
		"executeHint": {
			"type": "object",
			"additionalProperties": false,
			"required": ["runtime", "entry"],
			"properties": {
				"runtime": { "type": "string", "minLength": 1 },
				"entry": { "$ref": "#/$defs/relativePath" },
				"args": {
					"type": "array",
					"items": { "type": "string" }
				}
			}
		},
		"files": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["path", "size", "sha256"],
				"properties": {
					"path": { "$ref": "#/$defs/relativePath" },
					"size": { "type": "integer", "minimum": 0 },
					"sha256": {
						"type": "string",
						"pattern": "^[a-fA-F0-9]{64}$"
					},
					"executable": { "type": "boolean" },
					"downloadUrl": { "type": "string", "format": "uri" }
				}
			}
		}
	},
	"$defs": {
		"relativePath": {
			"type": "string",
			"minLength": 1,
			"not": {
				"anyOf": [
					{ "pattern": "^/" },
					{ "pattern": "^\\\\" },
					{ "pattern": "\\\\" },
					{ "pattern": ":" },
					{ "pattern": "(^|/)\\.($|/)" },
					{ "pattern": "(^|/)\\.\\.($|/)" }
				]
			}
		}
	}
}
