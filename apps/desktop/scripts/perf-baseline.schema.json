{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Superset Desktop Performance Baseline",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string"
		},
		"startup": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"notes": {
					"type": "string"
				},
				"measured": {
					"type": "boolean"
				},
				"marks": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"additionalProperties": false,
						"required": ["elapsedMs"],
						"properties": {
							"elapsedMs": {
								"type": "number",
								"exclusiveMinimum": 0
							}
						}
					}
				}
			}
		}
	}
}
