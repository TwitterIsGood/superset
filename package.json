{
	"name": "@superset/repo",
	"version": "0.0.0",
	"repository": {
		"type": "git"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.2",
		"@mindfoldhq/trellis": "0.6.0",
		"dotenv-cli": "11.0.0",
		"sherif": "1.11.0",
		"turbo": "2.9.14"
	},
	"description": "Superset Monorepo",
	"homepage": "https://superset.sh",
	"license": "Elastic-2.0",
	"packageManager": "bun@1.3.11",
	"private": true,
	"scripts": {
		"dev": "turbo run dev dev:caddy --filter=@superset/api --filter=@superset/web --filter=@superset/desktop --filter=electric-proxy --filter=//",
		"dev:all": "turbo dev",
		"dev:desktop": "turbo run dev --filter=@superset/api --filter=@superset/relay --filter=@superset/desktop --filter=electric-proxy --filter=//",
		"dev:desktop:caddy": "turbo run dev dev:caddy --filter=@superset/api --filter=@superset/relay --filter=@superset/desktop --filter=electric-proxy --filter=//",
		"dev:worktree:start": "./.superset/worktree-dev.sh start",
		"dev:worktree:start:loaded": "WORKTREE_DEV_LOAD_FIXTURE=1 ./.superset/worktree-dev.sh start",
		"dev:worktree:start:full": "WORKTREE_DEV_PROFILE=full ./.superset/worktree-dev.sh start",
		"dev:worktree:start:full:loaded": "WORKTREE_DEV_PROFILE=full WORKTREE_DEV_LOAD_FIXTURE=1 ./.superset/worktree-dev.sh start",
		"dev:worktree:start:lite": "WORKTREE_DEV_PROFILE=desktop-lite ./.superset/worktree-dev.sh start",
		"dev:worktree:start:lite:loaded": "WORKTREE_DEV_PROFILE=desktop-lite WORKTREE_DEV_LOAD_FIXTURE=1 ./.superset/worktree-dev.sh start",
		"dev:worktree:start:online-lite": "WORKTREE_DEV_PROFILE=desktop-online-lite ./.superset/worktree-dev.sh start",
		"dev:worktree:start:online-lite:loaded": "WORKTREE_DEV_PROFILE=desktop-online-lite WORKTREE_DEV_LOAD_FIXTURE=1 ./.superset/worktree-dev.sh start",
		"dev:worktree:status": "./.superset/worktree-dev.sh status",
		"dev:worktree:status:full": "WORKTREE_DEV_PROFILE=full ./.superset/worktree-dev.sh status",
		"dev:worktree:status:lite": "WORKTREE_DEV_PROFILE=desktop-lite ./.superset/worktree-dev.sh status",
		"dev:worktree:status:online-lite": "WORKTREE_DEV_PROFILE=desktop-online-lite ./.superset/worktree-dev.sh status",
		"dev:worktree:memory": "bun run scripts/dev-memory-report.ts",
		"dev:worktree:cleanup-pty-helpers": "bun run scripts/clean-stale-worktree-pty-helpers.ts",
		"dev:worktree:stop": "./.superset/worktree-dev.sh stop",
		"dev:worktree:cleanup": "./.superset/worktree-dev.sh cleanup",
		"dev:worktree": "bun run scripts/dev-worktree.ts",
		"desktop:perf-fixture": "bun run scripts/desktop-perf-fixture.ts",
		"desktop:perf-fixture:loaded": "bun run desktop:perf-fixture -- ensure --slug desktop-perf-loaded --projects 10 --workspaces-per-project 20 --tasks 300 --host-backed-workspaces 1",
		"desktop:perf-loaded-ui": "bun run scripts/desktop-perf-loaded-ui.ts",
		"desktop:perf-loaded-ui:dev-login": "bun run desktop:perf-loaded-ui -- --auto-login-dev --ensure-fixture",
		"desktop:perf-loaded-ui:online-lite": "DESKTOP_PERF_FIXTURE_DATABASE_URL=postgres://postgres:postgres@localhost:43014/main DESKTOP_PERF_FIXTURE_DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:43014/main bun run desktop:perf-loaded-ui -- --auto-login-dev --ensure-fixture --fixture-host-backed-workspaces 1",
		"dev:prepare": "bun run scripts/dev-worktree.ts --prepare-only",
		"dev:caddy": "dotenv -- caddy run --config Caddyfile",
		"e2e:workspace-fixture": "bun run scripts/e2e-workspace-fixture.ts",
		"mcp:desktop": "bun run packages/desktop-mcp/src/bin.ts",
		"desktop:automation": "bun run packages/desktop-mcp/src/cli.ts",
		"dev:docs": "turbo dev --filter=@superset/docs",
		"dev:marketing": "turbo dev --filter=@superset/marketing --filter=@superset/docs",
		"build": "turbo build --filter=@superset/desktop",
		"test": "turbo test --concurrency=2",
		"lint": "./scripts/lint.sh",
		"check:desktop-git-env": "./scripts/check-desktop-git-env.sh",
		"lint:fix": "bunx @biomejs/biome@2.4.2 migrate --write && bunx @biomejs/biome@2.4.2 check --write --unsafe .",
		"format": "bunx @biomejs/biome@2.4.2 format --write .",
		"format:check": "bunx @biomejs/biome@2.4.2 format .",
		"typecheck": "turbo typecheck",
		"ui-add": "turbo run ui-add",
		"postinstall": "./scripts/postinstall.sh",
		"clean": "git clean -xdf node_modules",
		"clean:workspaces": "turbo clean",
		"release:desktop": "./apps/desktop/create-release.sh",
		"release:canary": "./scripts/release-canary.sh",
		"online:start": "./scripts/superset-online.sh start",
		"online:start:loaded": "SUPERSET_ONLINE_LOAD_FIXTURE=1 ./scripts/superset-online.sh start",
		"online:stop": "./scripts/superset-online.sh stop",
		"online:status": "./scripts/superset-online.sh status",
		"online:install-launchd": "./scripts/superset-online.sh install-launchd",
		"online:uninstall-launchd": "./scripts/superset-online.sh uninstall-launchd",
		"db:push": "bun run --cwd packages/db push",
		"db:migrate": "bun run --cwd packages/db migrate",
		"db:seed-dev": "NODE_ENV=development bun run packages/auth/src/seed-dev.ts",
		"db:generate:desktop": "bun run --cwd packages/local-db generate"
	},
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*",
		"tooling/*"
	],
	"overrides": {
		"axios": "1.14.0",
		"hono": "4.12.23",
		"kysely": "0.28.17"
	},
	"trustedDependencies": [
		"better-sqlite3",
		"bufferutil",
		"electron",
		"esbuild",
		"koffi",
		"node-pty",
		"sharp",
		"utf-8-validate",
		"workerd"
	]
}
